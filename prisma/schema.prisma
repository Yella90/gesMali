// AUDIT
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

model AuditLog {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  action    String
  entite    String
  entiteId  String
  details   Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entite, entiteId])
  @@index([createdAt])
}

// ═════════════════════════════════════════════
// INSCRIPTION ANNUELLE (historique)
// ═════════════════════════════════════════════

model InscriptionAnnuelle {
  id              String        @id @default(cuid())
  eleveId         String
  eleve           Eleve         @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  classeId        String
  classe          Classe        @relation(fields: [classeId], references: [id])
  anneeScolaireId String
  anneeScolaire   AnneeScolaire @relation(fields: [anneeScolaireId], references: [id])

  decision        DecisionEleve
  moyenneAnnuelle Float?
  dateInscription DateTime      @default(now())
  note            String?

  createdAt DateTime @default(now())

  @@unique([eleveId, anneeScolaireId])
  @@index([classeId])
  @@index([anneeScolaireId])
}

enum DecisionEleve {
  INSCRIT
  ADMIS
  REDOUBLE
  DIPLOME
  TRANSFERE
}
// ═════════════════════════════════════════════
// TRESORERIE
// Encaissements de frais (PaiementFrais) et paiements du personnel (Paiement)
// ne sont pas recopies : le solde les calcule. Ici, les mouvements manuels.
// ═════════════════════════════════════════════

enum Caisse {
  ESPECES
  BANQUE
  MOBILE_MONEY
}

enum TypeMouvement {
  APPORT_CAPITAL
  DEPENSE
  RETRAIT_PROMOTEUR
}

model MouvementTresorerie {
  id String @id @default(cuid())

  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id])

  type      TypeMouvement
  caisse    Caisse
  date      DateTime
  montant   Float
  libelle   String
  categorie String? // depenses : Loyer, Electricite, Fournitures...
  reference String?

  // Sortie acceptee malgre un solde insuffisant (directeur, motif obligatoire)
  derogation      Boolean @default(false)
  motifDerogation String?

  annule          Boolean @default(false)
  motifAnnulation String?

  saisieParId String
  saisiePar   User   @relation("MouvementsSaisis", fields: [saisieParId], references: [id])

  createdAt DateTime @default(now())

  @@index([etablissementId, date])
}

// Depenses qui reviennent chaque mois (loyer, electricite...) : alerte de tresorerie
model DepenseRecurrente {
  id String @id @default(cuid())

  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id])

  libelle      String
  categorie    String
  montant      Float
  jourEcheance Int // 1 a 28
  caisse       Caisse
  actif        Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([etablissementId])
}

// ═════════════════════════════════════════════
// PRESENCES
// ═════════════════════════════════════════════

enum StatutPresence {
  PRESENT
  ABSENT
  RETARD
}

model Presence {
  id String @id @default(cuid())

  eleveId String
  eleve   Eleve  @relation(fields: [eleveId], references: [id], onDelete: Cascade)

  classeId String
  classe   Classe @relation(fields: [classeId], references: [id])

  date         DateTime @db.Date
  statut       StatutPresence
  justifie     Boolean  @default(false)
  motif        String?
  dureeMinutes Int?

  saisieParId String
  saisiePar   User   @relation(fields: [saisieParId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eleveId, date])
  @@index([classeId, date])
}

// ═════════════════════════════════════════════
// CONNEXION
// ═════════════════════════════════════════════

// Echecs de connexion recents, par e-mail ("email:...") et par adresse IP ("ip:...") :
// blocage temporaire commun a tous les serveurs. Table de la plateforme, sans ecole.
model EchecConnexion {
  cle    String   @id
  nombre Int      @default(1)
  depuis DateTime @default(now())

  @@index([depuis])
}
