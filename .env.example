# Copier ce fichier en .env et remplir les valeurs. Ne jamais commiter .env.

# Base PostgreSQL. Supabase : URL "Transaction pooler" (port 6543) pour l'application.
# Neon : URL "pooled" avec ?sslmode=require.
DATABASE_URL="postgresql://utilisateur:motdepasse@hote/base?sslmode=require"
# URL pour les migrations Prisma : Supabase "Session pooler" (port 5432),
# Neon URL directe (sans "-pooler").
# Facultatif : a defaut, DATABASE_URL est utilisee.
# DIRECT_URL="postgresql://utilisateur:motdepasse@hote-direct/base?sslmode=require"
# Schema PostgreSQL de l'application (defaut : public). Instance de demonstration
# dans un projet Supabase partage : ges_mali. Les migrations utilisent le meme schema.
# DATABASE_SCHEMA=ges_mali
# Supabase signe ses certificats avec sa propre autorite : coller le certificat CA
# (Project Settings > Database > SSL Configuration > Download certificate), le PEM
# sur une seule ligne, retours a la ligne remplaces par \n.
# A defaut, DATABASE_SSL_NO_VERIFY=1 (connexion chiffree, certificat non verifie).
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----"
# DATABASE_SSL_NO_VERIFY=1

# Auth.js : secret aleatoire, generer avec `npx auth secret` ou `openssl rand -base64 32`
AUTH_SECRET=""
# URL publique de l'application (sans / final)
AUTH_URL="https://ecole.exemple.ml"
# A mettre a true derriere un proxy / reverse proxy (hors Vercel)
# AUTH_TRUST_HOST=true

# URL publique utilisee dans les liens et QR codes de l'espace parent.
# Par defaut : AUTH_URL. Doit etre accessible depuis le telephone des parents.
APP_URL="https://ecole.exemple.ml"

# Administrateurs de la plateforme (page /plateforme : ecoles, essais, suspensions, creation
# d'ecoles) : e-mails separes par des virgules. Compte d'un administrateur sans ecole :
# npm run admin:creer -- vous@exemple.ml (mot de passe genere, a changer dans « Mon compte »).
# ADMINS_PLATEFORME="vous@exemple.ml"

# Envoi d'e-mails (inscription en ligne confirmee par e-mail, mot de passe oublie, confirmation
# d'adresse) : base PostgreSQL dediee contenant la table mail_sortant (envoi-mails/schema.sql),
# videe par la tache planifiee envoi-mails/envoyer.py. Sans cette variable, l'inscription libre
# et « mot de passe oublie » restent fermes. Les liens des e-mails utilisent APP_URL.
# MAIL_DATABASE_URL="postgresql://utilisateur:motdepasse@postgresql-xxx.alwaysdata.net/base_mails"
# Certificat de la base d'envoi non verifie (connexion toujours chiffree) :
# MAIL_DATABASE_SSL_NO_VERIFY=1

# Mot de passe du directeur de demonstration cree par prisma/seed.ts (a defaut : tire au
# hasard et affiche a la fin du seed)
# SEED_MOT_DE_PASSE=""

# Forcer les migrations pendant le build hors Vercel production (autre hebergeur, CI)
# MIGRER_AU_BUILD=1

# Variables Supabase (cles API, JWT) : inutiles pour GES Mali, qui ne parle qu'a la base.
# Ne jamais prefixer la cle service_role par NEXT_PUBLIC_ : elle serait exposee aux navigateurs.
