# Copier ce fichier en .env et remplir les valeurs. Ne jamais commiter .env.

# Base PostgreSQL (Neon : utiliser l'URL "pooled", avec ?sslmode=require)
DATABASE_URL="postgresql://utilisateur:motdepasse@hote/base?sslmode=require"
# URL directe (sans "-pooler") pour les migrations Prisma, recommandee avec Neon.
# Facultatif : a defaut, DATABASE_URL est utilisee.
# DIRECT_URL="postgresql://utilisateur:motdepasse@hote-direct/base?sslmode=require"
# Mettre a 1 seulement pour un serveur au certificat auto-signe (deconseille)
# DATABASE_SSL_NO_VERIFY=1

# Auth.js : secret aleatoire, generer avec `npx auth secret` ou `openssl rand -base64 32`
AUTH_SECRET=""
# URL publique de l'application (sans / final)
AUTH_URL="https://ecole.exemple.ml"
# A mettre a true derriere un proxy / reverse proxy (hors Vercel)
# AUTH_TRUST_HOST=true

# URL publique utilisee dans les liens et QR codes de l'espace parent.
# Par defaut : AUTH_URL. Doit etre accessible depuis le telephone des parents.
APP_URL="https://ecole.exemple.ml"

# Forcer les migrations pendant le build hors Vercel production (autre hebergeur, CI)
# MIGRER_AU_BUILD=1
